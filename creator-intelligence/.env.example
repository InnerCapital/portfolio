# Postgres connection string (Railway injects DATABASE_URL automatically when you add the Postgres plugin)
DATABASE_URL="postgresql://user:password@localhost:5432/ideasbank"

# Anthropic API key for the intelligence layer
ANTHROPIC_API_KEY=""
# Optional: override the model used for analysis and refinement
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Single shared password for the dashboard
APP_PASSWORD="change-me"
# Any long random string, used to sign the session cookie
SESSION_SECRET="change-me-to-a-long-random-string"

# Public URL of the deployed app, no trailing slash (used for the Instagram OAuth redirect)
APP_URL="https://your-app.up.railway.app"

# Instagram API with Instagram Login (Meta developer app, Instagram product)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# --- Measurement engine (Apify: real post metrics for you + competitors) ---
APIFY_TOKEN=""
# Optional actor overrides and limits
# APIFY_IG_PROFILE_ACTOR="apify~instagram-profile-scraper"
# APIFY_IG_COMMENT_ACTOR="apify~instagram-comment-scraper"
# APIFY_TIKTOK_ACTOR="clockworks~tiktok-scraper"
# APIFY_POST_LIMIT="30"
# APIFY_COMMENT_LIMIT="100"
# MEASURE_MIN_REFRESH_HOURS="12"
# Optional cheaper model for per-comment sentiment (e.g. a Haiku id)
# ANTHROPIC_MODEL_CHEAP=""

# --- Notion bridge (pull Content Data into Measure, push briefs to pipeline) ---
# Internal integration token; share both databases with this integration.
NOTION_TOKEN=""
# Database ids default to the real ones; override only if they move.
# NOTION_CONTENT_DATA_DB=""
# NOTION_PIPELINE_DB=""
