# Copy to .env.local for local work. On Vercel, add these in Project Settings > Environment Variables.

# Postgres connection string (Vercel Postgres / Neon). Must include sslmode=require.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# 32 random bytes, base64. Generate with: npm run gen:key
# LOSE THIS KEY AND EVERY STORED PASSWORD IS UNRECOVERABLE. Back it up in a second safe place.
VAULT_KEY=

# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Your Google Workspace domain, no @ sign. Only accounts on this domain can sign in.
ALLOWED_DOMAIN=yourcompany.com

# Comma separated emails allowed to add, edit, delete entries and see the audit log.
ADMIN_EMAILS=you@yourcompany.com
